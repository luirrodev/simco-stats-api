{
  "name": "simco-stats-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs --dataSource ./dist/core/database/data-source.js",
    "migration:gen": "npm run typeorm migration:generate ./src/core/database/migrations/$npm_config_name && prettier --write \"src/core/database/migrations/*.ts\"",
    "migration:run": "npm run typeorm migration:run",
    "migration:show": "npm run typeorm migration:show",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:drop": "npm run typeorm schema:drop",
    "seed": "ts-node -r tsconfig-paths/register src/core/database/seeds/seed.ts",
    "seed:dev": "NODE_ENV=dev pnpm run seed",
    "seed:prod": "NODE_ENV=prod pnpm run seed"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.2.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "fast-deep-equal": "^3.1.3",
    "ioredis": "^5.11.1",
    "joi": "^17.13.8",
    "luxon": "3.5.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "telegraf": "^4.16.3",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.16.2",
    "@types/bull": "^4.10.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/luxon": "3.4.2",
    "@types/node": "^22.20.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleNameMapper": {
      "^@features/(.*)$": "<rootDir>/features/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@common/(.*)$": "<rootDir>/core/common/$1",
      "^@logs/(.*)$": "<rootDir>/core/logs/$1",
      "^@utils/(.*)$": "<rootDir>/core/common/utils/$1"
    },
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
